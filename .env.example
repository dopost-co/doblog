# Database
DATABASE_URL="postgresql://user:password@localhost:5432/zenex_cms?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:4444"
NEXTAUTH_SECRET="tu-secret-super-seguro-cambialo-en-produccion"

# Node
NODE_ENV="development"

# MCP OAuth (optional overrides; defaults are derived from NEXTAUTH_URL)
# MCP_OAUTH_ISSUER="https://your-cms.example"
# Extra resource identifiers to accept besides NEXTAUTH_URL/api/mcp, e.g. the
# public URL of a standalone mcp-server/ gateway (see mcp-server/README.md).
# MCP_OAUTH_EXTRA_RESOURCES="https://mcp.your-cms.example/mcp"

# Scheduled publishing (Upstash QStash)
# Without QSTASH_TOKEN, scheduled posts are only published by the sweep endpoint.
QSTASH_URL="https://qstash.upstash.io"
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
# Public HTTPS origin QStash calls back (defaults to NEXTAUTH_URL; must be HTTPS).
# QSTASH_API_URL="https://your-cms.example"
# Optional: lets an external cron call POST /api/qstash/publish-scheduled with
# POST /api/qstash/content-discovery, or POST /api/qstash/growth-drafts with
# "Authorization: Bearer $CRON_SECRET".
# CRON_SECRET=""

# GitHub OAuth (optional)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Platform provider keys, used only for users on the "subscription" plan.
# "lifetime" users add their own OpenAI key and DataForSEO connection in
# Settings → Providers, so their usage is never billed to the platform.
OPENAI_API_KEY="your-openai-api-key"
# Optional model overrides for the Growth draft pipeline.
# OPENAI_CONTENT_MODEL="gpt-4.1-mini"
# OPENAI_IMAGE_MODEL="gpt-image-1.5"
# DATAFORSEO_LOGIN=""
# DATAFORSEO_PASSWORD=""

# Encrypts reusable third-party provider credentials (base64-encoded 32 bytes).
# Generate once and keep stable: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=""
# Comma-separated exact hosts or suffixes (leading dot) accepted by the MCP
# file downloader. Defaults to OpenAI/ChatGPT file delivery hosts.
MCP_FILE_DOWNLOAD_HOSTS="files.openai.com,.openai.com,.oaiusercontent.com,.chatgpt.com"

# Cloudflare R2 Storage
# Get these from your Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_URL="https://your-public-r2-domain.com"

# Notes for R2 setup:
# 1. Create an R2 bucket in your Cloudflare dashboard
# 2. Create an API token with R2 permissions
# 3. (Optional) Set up a custom domain for your R2 bucket for public access
#    or use the default R2.dev domain
# 4. Each blog will have its own folder: blogs/{blogId}/
