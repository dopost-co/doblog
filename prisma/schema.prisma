// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String? // Optional for OAuth users
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blogs Blog[]

  oauthAuthorizationCodes McpOAuthAuthorizationCode[]
  oauthGrants             McpOAuthGrant[]
  seoCredentials          SeoProviderCredential[]
}

model Blog {
  id          String   @id @default(cuid())
  userId      String
  name        String
  slug        String
  description String?
  blogId      String   @unique @default(uuid()) // UUID for API access
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts      Post[]
  categories Category[]
  tags       Tag[]
  authors    Author[]
  members    BlogMember[]
  apiKeys    ApiKey[]

  oauthAuthorizationCodes McpOAuthAuthorizationCode[]
  oauthGrants             McpOAuthGrant[]
  seoSettings             BlogSeoSettings?
  seoCacheEntries         SeoCacheEntry[]
  seoUsageEntries         SeoUsageEntry[]

  @@index([userId])
  @@index([blogId])
}

// Third-party provider secrets are encrypted with INTEGRATION_ENCRYPTION_KEY.
// A credential belongs to an owner account and may be reused by their blogs.
model SeoProviderCredential {
  id                String    @id @default(cuid())
  ownerUserId       String
  provider          String    @default("dataforseo")
  label             String
  encryptedLogin    String
  encryptedPassword String
  loginHint         String
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  owner        User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  blogSettings BlogSeoSettings[]
  usageEntries SeoUsageEntry[]

  @@index([ownerUserId, provider])
}

model BlogSeoSettings {
  id                     String   @id @default(cuid())
  blogId                 String   @unique
  credentialId           String?
  enabled                Boolean  @default(false)
  targetDomain           String?
  locationCode           Int      @default(2840)
  languageCode           String   @default("en")
  timezone               String   @default("UTC")
  competitorDomains      String[] @default([])
  audience               String?
  brandVoice             String?
  publishingMode         String   @default("draft")
  thumbnailStyle         String?
  inlineImageStyle       String?
  maxInlineImages        Int      @default(3)
  perRunBudgetUsdMicros  Int      @default(250000)
  dailyBudgetUsdMicros   Int      @default(1000000)
  monthlyBudgetUsdMicros Int      @default(20000000)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  blog       Blog                   @relation(fields: [blogId], references: [id], onDelete: Cascade)
  credential SeoProviderCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([credentialId])
}

model SeoCacheEntry {
  id          String   @id @default(cuid())
  blogId      String
  endpoint    String
  payloadHash String
  response    Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([blogId, endpoint, payloadHash])
  @@index([blogId, expiresAt])
}

model SeoUsageEntry {
  id             String    @id @default(cuid())
  blogId         String
  credentialId   String
  endpoint       String
  providerTaskId String?
  costUsdMicros  Int       @default(0)
  cacheHit       Boolean   @default(false)
  status         String    @default("reserved")
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  blog       Blog                  @relation(fields: [blogId], references: [id], onDelete: Cascade)
  credential SeoProviderCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([blogId, createdAt])
  @@index([credentialId, createdAt])
}

// Secrets are shown once; only SHA-256 digests of 256-bit random tokens are stored.
model ApiKey {
  id           String    @id @default(cuid())
  blogId       String
  name         String
  prefix       String
  tokenHash    String    @unique
  scopes       String[]
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  neverExpires Boolean   @default(false)
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  rateWindow   DateTime  @default(now())
  rateCount    Int       @default(0)
  blog         Blog      @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId, createdAt])
}

model Post {
  id                 String    @id @default(cuid())
  blogId             String
  title              String
  slug               String
  content            Json // Editor.js JSON format
  excerpt            String?
  coverImage         String?
  status             String    @default("draft") // draft | published
  featured           Boolean   @default(false)
  publishedAt        DateTime?
  authorId           String?
  language           String    @default("en") // ISO 639-1 language code
  translationGroupId String? // UUID to group translations of the same post

  // SEO fields
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  ogTitle         String?
  ogDescription   String?
  canonicalUrl    String?
  keywords        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blog       Blog           @relation(fields: [blogId], references: [id], onDelete: Cascade)
  author     Author?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categories PostCategory[]
  tags       PostTag[]

  @@unique([blogId, slug, language])
  @@index([blogId])
  @@index([blogId, status])
  @@index([blogId, slug])
  @@index([blogId, language])
  @@index([authorId])
  @@index([translationGroupId])
}

model Category {
  id          String   @id @default(cuid())
  blogId      String
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blog  Blog           @relation(fields: [blogId], references: [id], onDelete: Cascade)
  posts PostCategory[]

  @@unique([blogId, slug])
  @@index([blogId])
}

model PostCategory {
  id         String @id @default(cuid())
  postId     String
  categoryId String

  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([postId, categoryId])
  @@index([postId])
  @@index([categoryId])
}

model Tag {
  id        String   @id @default(cuid())
  blogId    String
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blog  Blog      @relation(fields: [blogId], references: [id], onDelete: Cascade)
  posts PostTag[]

  @@unique([blogId, slug])
  @@index([blogId])
}

model PostTag {
  id     String @id @default(cuid())
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@index([postId])
  @@index([tagId])
}

model Author {
  id        String   @id @default(cuid())
  blogId    String
  name      String
  email     String
  bio       String?
  avatar    String?
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blog  Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)
  posts Post[]

  @@unique([blogId, slug])
  @@unique([blogId, email])
  @@index([blogId])
}

model BlogMember {
  id        String   @id @default(cuid())
  blogId    String
  userEmail String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([blogId, userEmail])
  @@index([blogId])
  @@index([userEmail])
}

// OAuth 2.1 clients dynamically registered by MCP clients (RFC 7591). Public
// clients only: no secret, PKCE (S256) is required at the authorize/token step.
model McpOAuthClient {
  id            String   @id @default(cuid())
  clientId      String   @unique
  clientName    String?
  clientUri     String?
  logoUri       String?
  redirectUris  String[]
  grantTypes    String[]
  responseTypes String[]
  createdAt     DateTime @default(now())

  authorizationCodes McpOAuthAuthorizationCode[]
  grants             McpOAuthGrant[]
}

// Single-use, short-lived authorization_code grants (RFC 6749 4.1). The user
// can authorize one or more accessible blogs on the consent screen.
model McpOAuthAuthorizationCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  clientId      String
  userId        String
  blogIds       String[]
  blogId        String? // Legacy single-blog field kept temporarily for zero-downtime deploys.
  redirectUri   String
  codeChallenge String
  scopes        String[]
  resource      String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  usedAt        DateTime?

  client McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog   Blog?          @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// A standing authorization for a client, user and resource. Reauthorizing
// replaces the selected blogs and revokes the prior grant's tokens.
model McpOAuthGrant {
  id        String    @id @default(cuid())
  clientId  String
  userId    String
  blogIds   String[]
  blogId    String? // Legacy single-blog field kept temporarily for zero-downtime deploys.
  scopes    String[]
  resource  String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  client        McpOAuthClient         @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog          Blog?                  @relation(fields: [blogId], references: [id], onDelete: Cascade)
  accessTokens  McpOAuthAccessToken[]
  refreshTokens McpOAuthRefreshToken[]

  @@unique([clientId, userId, blogId])
  @@unique([clientId, userId, resource])
}

model McpOAuthAccessToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  grantId    String
  scopes     String[]
  resource   String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  grant McpOAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
}

// Rotated on every use; familyId lets reuse of an already-rotated token
// revoke the whole grant (RFC 6819 refresh token theft mitigation).
model McpOAuthRefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  grantId   String
  familyId  String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  rotatedAt DateTime?

  grant McpOAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@index([familyId])
}
