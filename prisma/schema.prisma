// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String? // Optional for OAuth users
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // lifetime: the user brings their own provider keys. subscription: the platform's keys are used.
  plan                  String  @default("lifetime")
  openaiApiKeyEncrypted String?
  openaiKeyHint         String?
  onboardingCompleted   Boolean @default(false)
  onboardingStep        String?

  blogs Blog[]

  oauthAuthorizationCodes McpOAuthAuthorizationCode[]
  oauthGrants             McpOAuthGrant[]
  seoCredentials          SeoProviderCredential[]
}

model Blog {
  id          String   @id @default(cuid())
  userId      String
  name        String
  slug        String
  description String?
  blogId      String   @unique @default(uuid()) // UUID for API access
  // ISO 639-1 codes the blog is written in; the first one is the main language.
  languages   String[] @default(["en"])
  // Keeps every translation group in step with the post that was last written.
  autoSyncTranslations Boolean @default(false)
  // How the owner uses this blog: "manual" (writes posts), "automatic" (Autopilot) or "both".
  contentMode String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts      Post[]
  categories Category[]
  tags       Tag[]
  authors    Author[]
  members    BlogMember[]
  apiKeys    ApiKey[]
  aiUsage    AiUsageEntry[]

  oauthAuthorizationCodes McpOAuthAuthorizationCode[]
  oauthGrants             McpOAuthGrant[]
  seoSettings             BlogSeoSettings?
  seoCacheEntries         SeoCacheEntry[]
  seoUsageEntries         SeoUsageEntry[]
  contentPlanItems        ContentPlanItem[]
  generationRuns          GenerationRun[]
  discoveryRuns           ContentDiscoveryRun[]
  mediaAssets             MediaAsset[]
  postSeoTargets          PostSeoTarget[]

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([blogId])
}

// Third-party provider secrets are encrypted with INTEGRATION_ENCRYPTION_KEY.
// A credential belongs to an owner account and may be reused by their blogs.
model SeoProviderCredential {
  id                String    @id @default(cuid())
  ownerUserId       String
  provider          String    @default("dataforseo")
  label             String
  encryptedLogin    String
  encryptedPassword String
  loginHint         String
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  owner        User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  blogSettings BlogSeoSettings[]
  usageEntries SeoUsageEntry[]

  @@index([ownerUserId, provider])
}

model BlogSeoSettings {
  id                     String   @id @default(cuid())
  blogId                 String   @unique
  credentialId           String?
  enabled                Boolean  @default(false)
  targetDomain           String?
  locationCode           Int      @default(2840)
  languageCode           String   @default("en")
  timezone               String   @default("UTC")
  competitorDomains      String[] @default([])
  audience               String?
  brandVoice             String?
  publishingMode         String   @default("draft")
  thumbnailEnabled       Boolean  @default(true)
  // "generated" (AI image), "template" (brand gradient + title) or
  // "template_illustration" (brand gradient + AI illustration + title).
  thumbnailFormat        String   @default("generated")
  // Brand gradient for template thumbnails: [from, to] as #rrggbb. Empty uses the default.
  thumbnailColors        String[] @default([])
  /// Brand card text: { font, size, bold, align, showBlogName }; missing values use the defaults.
  thumbnailTypography Json?
  // "linear" (diagonal) or "radial" (circular from the top-left corner).
  // Brand logo placed on generated images; a position per kind ("none" or top-left … bottom-right).
  logoUrl                String?
  /// Where an uploaded logo goes on the thumbnail; drawn only once a logo exists.
  thumbnailLogoPosition  String   @default("top-left")
  /// Images inside the article carry no logo unless one is placed by hand.
  inlineLogoPosition     String   @default("none")
  /// Output size preset for AI images (see lib/autopilot/image-sizes.ts); brand cards stay 16:9.
  thumbnailSize          String   @default("standard")
  inlineImageSize        String   @default("standard")
  thumbnailStyle         String?
  // Up to two uploaded images whose style generated images follow.
  thumbnailReferenceUrls String[] @default([])
  inlineImagesEnabled    Boolean  @default(true)
  inlineImageStyle       String?
  inlineImageReferenceUrls String[] @default([])
  maxInlineImages        Int      @default(3)
  articleUrlPrefix       String   @default("/blog")
  // Article path per language when the public site serves languages apart,
  // e.g. { "es": "/es/blog" } or a full URL for subdomains. Missing languages use articleUrlPrefix.
  articlePaths           Json     @default("{}")
  // Autopilot articles link to related published articles of the blog.
  internalLinksEnabled   Boolean  @default(true)
  // Published articles that mention a new Autopilot article's topic link to it (edits live posts).
  backlinksEnabled       Boolean  @default(true)
  sitemapUrl             String?
  discoveryEnabled       Boolean  @default(false)
  discoveryFrequency     String   @default("weekly") // weekly | monthly
  discoveryTopicsPerRun  Int      @default(8)
  draftAutomationEnabled Boolean  @default(false)
  draftsPerWeek          Int      @default(2)
  // Custom pace: UTC weekdays to write on (0 = Sunday … 6 = Saturday). Empty uses draftsPerWeek.
  writingDays            Int[]    @default([])
  discoveryRunningAt     DateTime?
  nextDiscoveryAt        DateTime?
  lastDiscoveryAt        DateTime?
  perRunBudgetUsdMicros  Int      @default(250000)
  dailyBudgetUsdMicros   Int      @default(1000000)
  monthlyBudgetUsdMicros Int      @default(20000000)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  blog       Blog                   @relation(fields: [blogId], references: [id], onDelete: Cascade)
  credential SeoProviderCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([credentialId])
  @@index([discoveryEnabled, nextDiscoveryAt])
}

model SeoCacheEntry {
  id          String   @id @default(cuid())
  blogId      String
  endpoint    String
  payloadHash String
  response    Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([blogId, endpoint, payloadHash])
  @@index([blogId, expiresAt])
}

model SeoUsageEntry {
  id             String    @id @default(cuid())
  blogId         String
  credentialId   String? // null when the platform's managed DataForSEO account paid for it
  endpoint       String
  providerTaskId String?
  costUsdMicros  Int       @default(0)
  cacheHit       Boolean   @default(false)
  status         String    @default("reserved")
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  error          String? // why a failed request failed, as DataForSEO or the network reported it

  blog       Blog                  @relation(fields: [blogId], references: [id], onDelete: Cascade)
  credential SeoProviderCredential? @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([blogId, createdAt])
  @@index([credentialId, createdAt])
}

// One OpenAI request made for a blog, with the tokens it used and what they cost.
model AiUsageEntry {
  id                String   @id @default(cuid())
  blogId            String
  provider          String   @default("openai")
  feature           String // article | discovery | brand_voice | cover_refresh | image_preview | translation
  kind              String // text | image
  model             String
  inputTokens       Int      @default(0) // includes cached and image input tokens
  cachedInputTokens Int      @default(0)
  imageInputTokens  Int      @default(0)
  outputTokens      Int      @default(0)
  costUsdMicros     Int? // null when the model has no known price
  paidBy            String // platform (subscription) | owner (the owner's own key)
  createdAt         DateTime @default(now())

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId, createdAt])
  @@index([createdAt])
}

// Secrets are shown once; only SHA-256 digests of 256-bit random tokens are stored.
model ApiKey {
  id           String    @id @default(cuid())
  blogId       String
  name         String
  prefix       String
  tokenHash    String    @unique
  scopes       String[]
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  neverExpires Boolean   @default(false)
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  rateWindow   DateTime  @default(now())
  rateCount    Int       @default(0)
  blog         Blog      @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId, createdAt])
}

model Post {
  id                 String    @id @default(cuid())
  blogId             String
  title              String
  /// Short headline drawn on the brand thumbnail; the title is used when unset.
  coverTitle         String?
  slug               String
  content            Json // Editor.js JSON format
  excerpt            String?
  coverImage         String?
  status             String    @default("draft") // draft | scheduled | published
  featured           Boolean   @default(false)
  publishedAt        DateTime? // Publication date; for scheduled posts, when they go live
  scheduleMessageId  String? // QStash message that publishes a scheduled post
  authorId           String?
  language           String    @default("en") // ISO 639-1 language code
  translationGroupId String? // UUID to group translations of the same post
  // The text changed and the rest of the group has not been re-translated yet.
  translationSyncPending Boolean @default(false)

  // SEO fields
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  ogTitle         String?
  ogDescription   String?
  canonicalUrl    String?
  keywords        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blog       Blog           @relation(fields: [blogId], references: [id], onDelete: Cascade)
  author     Author?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categories PostCategory[]
  tags       PostTag[]
  contentPlanItem ContentPlanItem?
  generationRuns  GenerationRun[]
  mediaAssets     MediaAsset[]
  seoTarget       PostSeoTarget?

  @@unique([blogId, slug, language])
  @@index([blogId])
  @@index([blogId, status])
  @@index([status, publishedAt])
  @@index([blogId, slug])
  @@index([blogId, language])
  @@index([authorId])
  @@index([translationGroupId])
}

// A visible, editable editorial queue. Adding an item means the topic is
// approved for drafting; generation itself is tracked separately below.
model ContentPlanItem {
  id                String    @id @default(cuid())
  blogId            String
  postId            String?   @unique
  primaryKeyword    String
  normalizedKeyword String
  secondaryKeywords String[]  @default([])
  title             String?
  intent            String?
  cluster           String?
  language          String    @default("en")
  notes             String?
  source            String    @default("manual") // manual | discovery
  rationale         String?
  opportunitySnapshot Json?
  status            String    @default("planned") // planned | generating | ready | failed
  scheduledFor      DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  blog Blog  @relation(fields: [blogId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id], onDelete: SetNull)
  runs GenerationRun[]

  @@unique([blogId, normalizedKeyword, language])
  @@index([blogId, status, scheduledFor])
  @@index([status, scheduledFor])
  @@index([postId])
}

// One auditable pass over the site's existing content and search opportunities.
// Discovery runs only add ideas to the queue. A separate scheduler may later
// turn dated ideas into drafts, while publication always remains separate.
model ContentDiscoveryRun {
  id               String    @id @default(cuid())
  blogId           String
  trigger          String    @default("dashboard") // dashboard | mcp | scheduler
  status           String    @default("running") // running | completed | failed
  stage            String    @default("sitemap")
  domain           String
  sitemapUrl       String?
  sitemapUrls      String[]  @default([])
  discoveredPages  Int       @default(0)
  suggestionsAdded Int       @default(0)
  warnings         String[]  @default([])
  inputSnapshot    Json?
  outputSnapshot   Json?
  error            String?
  createdAt        DateTime  @default(now())
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId, createdAt])
  @@index([status, createdAt])
}

// One durable record per attempt makes long AI work observable and retryable.
model GenerationRun {
  id                String    @id @default(cuid())
  blogId            String
  planItemId        String?
  postId            String?
  trigger           String    @default("dashboard") // dashboard | api | mcp | scheduler
  status            String    @default("queued") // queued | running | completed | failed
  stage             String    @default("queued")
  provider          String    @default("openai")
  model             String?
  promptVersion     String    @default("article-v1")
  inputSnapshot     Json?
  outputSnapshot    Json?
  inputTokens       Int?
  outputTokens      Int?
  error             String?
  createdAt         DateTime  @default(now())
  startedAt         DateTime?
  completedAt       DateTime?

  blog     Blog             @relation(fields: [blogId], references: [id], onDelete: Cascade)
  planItem ContentPlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  post     Post?            @relation(fields: [postId], references: [id], onDelete: SetNull)
  media    MediaAsset[]

  @@index([blogId, createdAt])
  @@index([planItemId, createdAt])
  @@index([postId])
}

// Generated and uploaded images become first-class records instead of orphaned
// URLs, so their purpose, prompt, ownership and usage remain understandable.
model MediaAsset {
  id             String   @id @default(cuid())
  blogId         String
  postId         String?
  generationRunId String?
  kind           String   @default("inline") // cover | inline
  origin         String   @default("generated") // generated | upload | mcp
  url            String   @unique
  storageKey     String?
  prompt         String?
  revisedPrompt  String?
  altText        String?
  caption        String?
  mimeType       String
  byteSize       Int
  sha256         String
  provider       String?
  model          String?
  /// For a brand-card cover: the stored AI illustration on it, so the card is redrawn per language with the same art.
  illustrationUrl String?
  createdAt      DateTime @default(now())

  blog          Blog           @relation(fields: [blogId], references: [id], onDelete: Cascade)
  post          Post?          @relation(fields: [postId], references: [id], onDelete: SetNull)
  generationRun GenerationRun? @relation(fields: [generationRunId], references: [id], onDelete: SetNull)

  @@index([blogId, createdAt])
  @@index([postId])
  @@index([sha256])
}

// The strategic SEO target is structured and separate from the legacy free-form
// Post.keywords field, which remains for delivery compatibility.
model PostSeoTarget {
  id                String   @id @default(cuid())
  blogId            String
  postId            String   @unique
  primaryKeyword    String
  normalizedKeyword String
  secondaryKeywords String[] @default([])
  intent            String?
  cluster           String?
  language          String   @default("en")
  brief             Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([blogId, normalizedKeyword, language])
  @@index([blogId, cluster])
}

model Category {
  id          String   @id @default(cuid())
  blogId      String
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blog  Blog           @relation(fields: [blogId], references: [id], onDelete: Cascade)
  posts PostCategory[]

  @@unique([blogId, slug])
  @@index([blogId])
}

model PostCategory {
  id         String @id @default(cuid())
  postId     String
  categoryId String

  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([postId, categoryId])
  @@index([postId])
  @@index([categoryId])
}

model Tag {
  id        String   @id @default(cuid())
  blogId    String
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blog  Blog      @relation(fields: [blogId], references: [id], onDelete: Cascade)
  posts PostTag[]

  @@unique([blogId, slug])
  @@index([blogId])
}

model PostTag {
  id     String @id @default(cuid())
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@index([postId])
  @@index([tagId])
}

model Author {
  id        String   @id @default(cuid())
  blogId    String
  name      String
  email     String
  bio       String?
  avatar    String?
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blog  Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)
  posts Post[]

  @@unique([blogId, slug])
  @@unique([blogId, email])
  @@index([blogId])
}

model BlogMember {
  id        String   @id @default(cuid())
  blogId    String
  userEmail String
  role      String   @default("member") // viewer | member | admin (lib/permissions.ts)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([blogId, userEmail])
  @@index([blogId])
  @@index([userEmail])
}

// OAuth 2.1 clients dynamically registered by MCP clients (RFC 7591). Public
// clients only: no secret, PKCE (S256) is required at the authorize/token step.
model McpOAuthClient {
  id            String   @id @default(cuid())
  clientId      String   @unique
  clientName    String?
  clientUri     String?
  logoUri       String?
  redirectUris  String[]
  grantTypes    String[]
  responseTypes String[]
  createdAt     DateTime @default(now())

  authorizationCodes McpOAuthAuthorizationCode[]
  grants             McpOAuthGrant[]
}

// Single-use, short-lived authorization_code grants (RFC 6749 4.1). The user
// can authorize one or more accessible blogs on the consent screen.
model McpOAuthAuthorizationCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  clientId      String
  userId        String
  blogIds       String[]
  blogId        String? // Legacy single-blog field kept temporarily for zero-downtime deploys.
  redirectUri   String
  codeChallenge String
  scopes        String[]
  resource      String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  usedAt        DateTime?

  client McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog   Blog?          @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// A standing authorization for a client, user and resource. Reauthorizing
// replaces the selected blogs and revokes the prior grant's tokens.
model McpOAuthGrant {
  id        String    @id @default(cuid())
  clientId  String
  userId    String
  blogIds   String[]
  blogId    String? // Legacy single-blog field kept temporarily for zero-downtime deploys.
  scopes    String[]
  resource  String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  client        McpOAuthClient         @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog          Blog?                  @relation(fields: [blogId], references: [id], onDelete: Cascade)
  accessTokens  McpOAuthAccessToken[]
  refreshTokens McpOAuthRefreshToken[]

  @@unique([clientId, userId, blogId])
  @@unique([clientId, userId, resource])
}

model McpOAuthAccessToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  grantId    String
  scopes     String[]
  resource   String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  grant McpOAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
}

// Rotated on every use; familyId lets reuse of an already-rotated token
// revoke the whole grant (RFC 6819 refresh token theft mitigation).
model McpOAuthRefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  grantId   String
  familyId  String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  rotatedAt DateTime?

  grant McpOAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@index([familyId])
}
